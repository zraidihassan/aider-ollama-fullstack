# Copie ce fichier en .env et adapte les valeurs.
# docker compose le charge automatiquement.

# ============================================================
# OBLIGATOIRE : chemin absolu vers ton projet Spring Boot + Angular
#   Windows  : C:\Users\moi\dev\mon-projet
#   Mac/Linux: /home/moi/dev/mon-projet
#
# Le projet peut être un monorepo (backend/ + frontend/) ou un dépôt
# unique : les scripts détectent automatiquement pom.xml et package.json.
# ============================================================
PROJECT_PATH=

# ============================================================
# MODÈLES OLLAMA — choisis un profil selon ta VRAM GPU
# ------------------------------------------------------------
# AIDER_MODEL       = modèle d'ÉDITION (génère les diffs, usage quotidien)
# AIDER_WEAK_MODEL  = modèle secondaire (résumés / repo-map) ; le mettre
#                     égal à AIDER_MODEL pour ne charger qu'un seul modèle.
# ============================================================

# --- Profil ÉQUILIBRÉ (~12 Go VRAM, recommandé) : codeur instruct, diffs fiables
AIDER_MODEL=ollama/qwen2.5-coder:14b
AIDER_WEAK_MODEL=ollama/qwen2.5-coder:14b

# --- Profil LÉGER (~8 Go VRAM ou machine chargée) : 7b partout
# AIDER_MODEL=ollama/qwen2.5-coder:7b
# AIDER_WEAK_MODEL=ollama/qwen2.5-coder:7b

# --- Profil RÉFLEXION (refactos délicats) : modèle "thinking" Qwen3-14B
#     À activer ponctuellement (un modèle qui raisonne casse parfois le
#     format de diff). Le lanceur agent.sh propose aussi l'option --think.
# AIDER_MODEL=ollama/qwen3:14b
# AIDER_WEAK_MODEL=ollama/qwen3:14b

# --- Profil PUISSANT (~24 Go VRAM ou offload CPU accepté) : MoE code
# AIDER_MODEL=ollama/qwen3-coder:30b
# AIDER_WEAK_MODEL=ollama/qwen3-coder:30b

# Modèles à télécharger côté Ollama (sur l'hôte) :
#   ollama pull qwen2.5-coder:14b      # édition (défaut)
#   ollama pull qwen2.5-coder:7b       # profil léger
#   ollama pull qwen3:14b              # réflexion / thinking
#   ollama pull qwen2.5-coder:1.5b     # autocomplétion (Continue.dev)

# ============================================================
# Divers
# ============================================================
# Nombre max d'itérations de correction automatique des tests
MAX_ITER=3

# Mémoire JVM Maven (baisse à -Xmx1g sur machine modeste)
MAVEN_OPTS=-Xmx2g -XX:+UseG1GC
